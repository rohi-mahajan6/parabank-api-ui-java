# Copy to .env and fill in. .env is gitignored.

# public = parabank.parasoft.com, read-only smoke only (write calls are blocked by DockerGuard)
# docker = local or CI ParaBank container, full suite
TEST_ENV=public

PARABANK_BASE_URL=https://parabank.parasoft.com/parabank
PARABANK_API_URL=https://parabank.parasoft.com/parabank/services/bank

# Demo account credentials (public demo values; set them here, not in code)
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Browser. If not set: headless when CI is set, visible otherwise.
# HEADLESS=true
