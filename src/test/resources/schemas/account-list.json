{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Account[]",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "customerId", "type", "balance"],
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "customerId": { "type": "integer", "minimum": 1 },
      "type": { "type": "string", "enum": ["CHECKING", "SAVINGS", "LOAN"] },
      "balance": { "type": "number" }
    }
  }
}
